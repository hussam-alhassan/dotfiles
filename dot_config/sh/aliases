alias copy=wl-copy

# dots
alias .s='source $RC'
alias .r='$EDITOR $RC'
alias .e='$EDITOR ~/.config/sh/exports'
alias .a='$EDITOR ~/.config/sh/aliases'
alias .v='$EDITOR ~/.config/nvim/init.lua'
alias .g='$EDITOR ~/.config/git/config'

alias .sway='$EDITOR ~/.config/sway/config'
alias .swaylock='$EDITOR ~/.config/swaylock/config'
alias .foot='$EDITOR ~/.config/foot/foot.ini'
alias .status='$EDITOR ~/.config/i3status-rust/config.toml'

# ls
alias ls='ls --group-directories-first'
alias l='ls --color -CF1'
alias l.='ls --color -d .* --color=auto'
alias ls='ls --color'
alias ll='ls --color -l --group-directories-first'
alias la='ls --color -A'
alias ll.='ls --color -l -d .* --color=auto'

# grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Modern replacements
# alias bat="batcat"
alias cat="bat -pp" # --plain --paging=never
alias vim="nvim"

# Other
alias publicip='curl ipinfo.io | jq'
